experiment:
  name: dual_track_refactor
  output_root: data/reports

training:
  enabled: false
  script: finetune_llama3_ddi.py
  args:
    - --data_path
    - data/finetune/train/input_label_only_without_kg.json
    - --output_dir
    - results/llama3_ddi_lora_label_only_without_kg

classification_eval:
  enabled: false
  model_name: medgemma27b_text
  model_id: models/google/medgemma-27b-text-it
  test_data: data/raw/test_augmented_data.csv
  output_dir: data/reports/dual_track_refactor/classification
  max_new_tokens: 256

explanation_eval:
  enabled: false
  model_name: llama3_reasoning_adapter
  predictions_file: data/reports/dual_track_refactor/inference/TODO_explanation_predictions.json
  output_dir: data/reports/dual_track_refactor/explanation_eval

judge:
  enabled: false
  model_id: qwen-max
  # api_key: ${DASHSCOPE_API_KEY}
  base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
  max_retries: 4
  retry_delay: 2.0
