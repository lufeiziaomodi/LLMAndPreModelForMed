      "results/eval_report/restart_reasoning_without_kg_bootstrap/finetune_dataset_input_test_metrics_reasoning_without_kg.json",
      "--prompt_mode",
      "explanation_without_kg",
      "--max_new_tokens",
      "-1",
      "--multi_gpu_shard",
      "--temperature",
      "0.0",
      "--top_p",
      "1.0"
